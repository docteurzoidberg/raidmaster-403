# Build directories
build-*/
build/

# Simulator state
sim-storage.json

# C/C++ artefacts
*.o
*.obj
*.a
*.so
*.dylib
*.exe
*.d

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Testing/
compile_commands.json

# ESP-IDF (sdkconfig dans build-firmware/, sdkconfig.defaults fait foi). Le dependencies.lock du
# firmware est versionné : versions exactes des composants, builds reproductibles.
sdkconfig
sdkconfig.old
managed_components/
dependencies.lock
!software/firmware/dependencies.lock

# Références externes (clones en lecture seule, traces NMEA longues)
software/references/

# Roadbooks d'exemple téléchargés (droits de leurs auteurs) : seul le README est versionné
docs/roadbooks/*
!docs/roadbooks/README.md

# Datasheets (hardware/fetch_datasheets.sh) et modèle 3D de la carte : droits des fabricants
hardware/datasheets/
enclosure/cad/

# Éditeurs / IDE
.vscode/
.idea/
*.swp
*.swo
.cache/

# OS
.DS_Store
Thumbs.db

# Python (venv local optionnel pour Pillow, caches)
.venv/
__pycache__/
*.pyc

# Blender (sauvegardes automatiques)
*.blend1

# Skills Claude Code locaux (non partagés) ; sim-check, firmware, ship et pcb-carte-fille sont versionnés
.claude/skills/ui-shots/
.claude/skills/boot-anim/
.claude/skills/ui-font/
.claude/settings.local.json

# KiCad (sauvegardes, verrous, caches ; STEP exportés par le skill pcb-carte-fille, régénérables)
*-backups/
*.lck
~*.lck
fp-info-cache
*.kicad_prl
_autosave-*
hardware/kicad/*/export/
