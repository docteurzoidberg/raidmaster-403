{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "sim",
            "displayName": "Simulateur PC (SDL)",
            "description": "Build de la cible sim 480x320. Dépendance système : libsdl2-dev.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-sim",
            "cacheVariables": {
                "RAIDMASTER_TARGET": "sim",
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "sim",
            "configurePreset": "sim"
        }
    ],
    "testPresets": [
        {
            "name": "sim",
            "configurePreset": "sim",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "jobs": 8
            }
        }
    ]
}
