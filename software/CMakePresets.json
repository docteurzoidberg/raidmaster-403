{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "sim",
            "displayName": "Simulateur PC (SDL)",
            "description": "Build de la cible sim 480x320. Dépendance système : libsdl2-dev.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-sim",
            "cacheVariables": {
                "RAIDMASTER_TARGET": "sim",
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "web",
            "displayName": "Simulateur web (WebAssembly)",
            "description": "Build du sim web (emcc). Activer emsdk avant : tools/web.sh le fait.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-web",
            "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
            "cacheVariables": {
                "RAIDMASTER_TARGET": "web",
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "sim",
            "configurePreset": "sim"
        },
        {
            "name": "web",
            "configurePreset": "web"
        }
    ],
    "testPresets": [
        {
            "name": "sim",
            "configurePreset": "sim",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "jobs": 8
            }
        }
    ]
}
